generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contents  Content[] // A relation to the Content model
}

model Viewer {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  firstName  String
  lastName   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  favorites  Favorite[] // Relation to Favorite model
}

model Content {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  shortDesc   String         // Short description
  category    Category
  status      ContentStatus  @default(DRAFT) // Enum for content status (draft, published, deleted)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deleted     Boolean        @default(false)

  adminId     String
  admin       Admin          @relation(fields: [adminId], references: [id])

  media       Media?
  mediaId     String?

  favorites   Favorite[]     // Track favorites for content
  views       Int            @default(0)  // For basic analytics (e.g., number of views)

  recipes     Recipe[]       // Store recipe ingredients
  instructions RecipeInstruction[] // Store recipe instructions
}

model Media {
  id          String   @id @default(uuid())
  image1Url   String?
  image2Url   String?
  videoUrl    String?
  uploadedAt  DateTime @default(now())

  content     Content? @relation(fields: [contentId], references: [id])
  contentId   String?  @unique
}

model Recipe {
  id          String   @id @default(uuid())
  ingredient  String   // Simple string input for ingredients

  contentId   String
  content     Content  @relation(fields: [contentId], references: [id])
}

model RecipeInstruction {
  id          String   @id @default(uuid())
  instruction String   // Instruction step as a string
  stepNumber  Int      // The order of the instruction step (e.g., 1, 2, 3...)
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id])
}

model Favorite {
  id         String   @id @default(uuid())
  viewerId   String
  contentId  String
  createdAt  DateTime @default(now())

  viewer     Viewer   @relation(fields: [viewerId], references: [id])
  content    Content  @relation(fields: [contentId], references: [id])

  @@unique([viewerId, contentId]) // Prevent double favorites
}

enum Category {
  DESSERT
  ENTREE
  APPETIZER
  DRINKS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  DELETED
}